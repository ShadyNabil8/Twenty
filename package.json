{
  "name": "eye-202020",
  "version": "0.1.0",
  "description": "Cross-platform 20-20-20 eye-strain break enforcer: dark overlays on every screen, mouse confinement, idle-aware timer, tray countdown.",
  "main": "out/main/index.js",
  "author": "SHADY",
  "license": "MIT",
  "private": true,
  "scripts": {
    "predev": "npm run icons",
    "dev": "electron-vite dev",
    "dev:fast": "npm run icons && cross-env EYE2020_FAST=1 electron-vite dev",
    "prebuild": "npm run icons",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "koffi": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
